class Cube{
    int length;
    int breadth;
    int height;
    public Cube(int l, int b,int h){
        this.length = l;
        this.breadth = b;
        this.height = h;
    }
    public void volume(){
        System.out.println("Volume of cube"+ this.length*this.breadth*this.height);
    }
}
class Actor{
    String name;
    int age;
    public Actor(String n, int a){
        this.name =n;
        this.age = a;
    }
    public  void stageName(){
        System.out.println("Stage name of actor is"+ this.name + "and age is" + this.age);
    }
}
public class Meth{
    public static void main(String[] args){
        Cube c1=new Cube(10,22,4);
        Actor a1 =new Actor("Rabbit",20);
        c1.volume();
        a1.stageName();
    }
}
       
